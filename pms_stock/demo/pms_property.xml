<odoo noupdate="1">
    <record id="demo_stock_location_downtown" model="stock.location">
        <field name="name">Downtown Apartment</field>
        <field name="location_id" ref="stock.stock_location_locations" />
        <field name="usage">internal</field>
    </record>

    <record id="demo_stock_location_suburban" model="stock.location">
        <field name="name">Suburban House</field>
        <field name="location_id" ref="stock.stock_location_locations" />
        <field name="usage">internal</field>
    </record>

    <record id="pms_base.demo_property_downtown" model="pms.property">
        <field name="stock_location_id" ref="demo_stock_location_downtown" />
    </record>

    <record id="pms_base.demo_property_suburban" model="pms.property">
        <field name="stock_location_id" ref="demo_stock_location_suburban" />
    </record>
</odoo>
